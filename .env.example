# HydroGrid Environment Configuration Template

# Server Configuration (SERVER ONLY)
NODE_ENV=development
PORT=3000

# Supabase Infrastructure (SERVER ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Supabase Public / Client-Safe Configuration
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# InfluxDB Time-Series Database (SERVER ONLY)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-influxdb-token
INFLUXDB_ORG=hydrogrid
INFLUXDB_BUCKET=telemetry