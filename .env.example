# HydroGrid Environment Configuration Template

# Server Configuration (SERVER ONLY)
NODE_ENV=development
PORT=3000

# Relational Database (PostgreSQL via Prisma)
DATABASE_URL=postgresql://postgres:password@localhost:5432/hydrogrid

# InfluxDB Time-Series Database (SERVER ONLY)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-influxdb-token
INFLUXDB_ORG=hydrogrid
INFLUXDB_BUCKET=telemetry
 
# Feature Flags (Hardware Prototype Profiles)
VITE_ENABLE_PURIFICATION=false
VITE_ENABLE_ALL_SENSORS=false

# MQTT Broker Configuration (SERVER ONLY - Edge Telemetry & Actuation)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=hydrogrid-server
MQTT_ENABLED=false
