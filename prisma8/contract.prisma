// HydroGrid Prisma Schema
// PostgreSQL Relational Database Model

enum SiteStatus {
  ONLINE
  OFFLINE
  DEGRADED
}

enum DeviceType {
  SOURCE_SENSOR_NODE
  PURIFICATION_CONTROLLER
  DISTRIBUTION_NODE
}

enum DeviceStatus {
  ONLINE
  DEGRADED
  OFFLINE
  FAULT
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum EventSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertSeverity {
  WARNING
  CRITICAL
}

enum AlertStatus {
  UNREAD
  READ
  ACKNOWLEDGED
}

enum SensorHealthStatus {
  HEALTHY
  DEGRADED
  CALIBRATION_REQUIRED
  FAULT
}

enum FilterType {
  SEDIMENT
  CARBON
  CALCITE
  UV
}

enum FilterStatus {
  HEALTHY
  WARNING
  DEGRADED
  FAULT
}

model Site {
  id                    Uuid                   @id @default(dbgenerated("gen_random_uuid()"))
  name                  String
  village               String
  district              String
  state                 String
  latitude              Float
  longitude             Float
  status                SiteStatus             @default(ONLINE)
  createdAt             TimestamptzString            @default(now()) @map("created_at")
  updatedAt             temporal.updatedAtString()   @map("updated_at")
  devices               Device[]
  memberships           SiteMembership[]
  qualityConfiguration  QualityConfiguration?
  events                Event[]
  alerts                Alert[]
  sensorCalibrations    SensorCalibration[]
  filterMaintenances    FilterMaintenance[]

  @@map("sites")
}

model Device {
  id                 Uuid                @id @default(dbgenerated("gen_random_uuid()"))
  siteId             Uuid                @map("site_id")
  name               String
  type               DeviceType
  status             DeviceStatus        @default(ONLINE)
  firmwareVersion    String              @default("1.0.0") @map("firmware_version")
  lastSeenAt         TimestamptzString         @default(now()) @map("last_seen_at")
  createdAt          TimestamptzString         @default(now()) @map("created_at")
  site               Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  events             Event[]
  sensorCalibrations SensorCalibration[]

  @@index([siteId], map: "idx_devices_site_id")
  @@map("devices")
}

model SiteMembership {
  id        Uuid     @id @default(dbgenerated("gen_random_uuid()"))
  userId    Uuid     @map("user_id")
  siteId    Uuid     @map("site_id")
  role      UserRole @default(VIEWER)
  createdAt TimestamptzString @default(now()) @map("created_at")
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId], map: "uq_site_membership")
  @@index([userId], map: "idx_site_memberships_user")
  @@index([siteId], map: "idx_site_memberships_site")
  @@map("site_memberships")
}

model QualityConfiguration {
  id                     Uuid                 @id @default(dbgenerated("gen_random_uuid()"))
  siteId                 Uuid                 @unique @map("site_id")
  minPh                  Float                @default(6.5) @map("min_ph")
  maxPh                  Float                @default(8.5) @map("max_ph")
  maxTds                 Float                @default(500.0) @map("max_tds")
  maxTurbidity           Float                @default(5.0) @map("max_turbidity")
  maxFlowMismatchPercent Float                @default(15.0) @map("max_flow_mismatch_percent")
  updatedAt              temporal.updatedAtString() @map("updated_at")
  site                   Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("quality_configurations")
}

model Event {
  id           Uuid          @id @default(dbgenerated("gen_random_uuid()"))
  siteId       Uuid          @map("site_id")
  deviceId     Uuid?         @map("device_id")
  type         String
  severity     EventSeverity @default(INFO)
  message      String
  acknowledged Boolean       @default(false)
  createdAt    TimestamptzString   @default(now()) @map("created_at")
  site         Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  device       Device?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  alerts       Alert[]

  @@index([siteId, createdAt], map: "idx_events_site_created")
  @@map("events")
}

model Alert {
  id             Uuid          @id @default(dbgenerated("gen_random_uuid()"))
  siteId         Uuid          @map("site_id")
  eventId        Uuid?         @map("event_id")
  type           String
  severity       AlertSeverity @default(WARNING)
  status         AlertStatus   @default(UNREAD)
  message        String
  acknowledgedAt TimestamptzString?  @map("acknowledged_at")
  acknowledgedBy Uuid?         @map("acknowledged_by")
  createdAt      TimestamptzString   @default(now()) @map("created_at")
  site           Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  event          Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([siteId, status], map: "idx_alerts_site_status")
  @@map("alerts")
}

model SensorCalibration {
  id                Uuid               @id @default(dbgenerated("gen_random_uuid()"))
  siteId            Uuid               @map("site_id")
  deviceId          Uuid?              @map("device_id")
  sensor            String
  status            SensorHealthStatus @default(HEALTHY)
  offset            Float              @default(0.0)
  lastCalibratedAt  TimestamptzString        @default(now()) @map("last_calibrated_at")
  nextCalibrationAt TimestamptzString        @default(now()) @map("next_calibration_at")
  createdAt         TimestamptzString        @default(now()) @map("created_at")
  site              Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  device            Device?            @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([siteId], map: "idx_sensor_calibrations_site")
  @@map("sensor_calibrations")
}

model FilterMaintenance {
  id               Uuid         @id @default(dbgenerated("gen_random_uuid()"))
  siteId           Uuid         @map("site_id")
  filterType       FilterType   @map("filter_type")
  status           FilterStatus @default(HEALTHY)
  lifePercent      Float        @default(100.0) @map("life_percent")
  lastServicedAt   TimestamptzString  @default(now()) @map("last_serviced_at")
  nextServiceDueAt TimestamptzString  @default(now()) @map("next_service_due_at")
  notes            String?
  createdAt        TimestamptzString  @default(now()) @map("created_at")
  site             Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId], map: "idx_filter_maintenance_site")
  @@map("filter_maintenance")
}
